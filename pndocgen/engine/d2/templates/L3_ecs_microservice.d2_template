{# pn-docgen L3 ECS Microservice Template (v74 Golden Layout)
   Pattern: ecs_microservice

   Layout — follows golden_v74 reference:
     - 5 invisible column wrappers (col1…col5) with direction:down
     - grid-columns:1 inside each boundary box for perfect vertical alignment
     - Box-level edges between clusters (not node-level) → ELK orthogonal routing works
     - ELK with ORTHOGONAL routing and hierarchyHandling:INCLUDE_CHILDREN
     - Column order: col1 (apigw+rules) → col2 (queues) → col3 (ecs+lambdas)
                     → col4 (dynamodb) → col5 (external)

   Input variables:
     service_name  : str  — e.g. "pn-delivery"
     service_id    : str  — safe D2 id (unused in body, for comment only)
     clusters      : dict — {cluster_name: [{id, label, icon, width, height, resource_type}]}
                     Expected keys: apigw, rules, queues, ecs, lambdas, dynamodb, storage, external
     box_edges     : list — [{from_box, to_box, label, stroke_color, stroke_dash}]
                     Box-level (cluster→cluster) edges, pre-computed by generator
     structural_edges: list — (unused, column structure embedded in template)
#}

# StandardAWSLayout v74 — ECS Microservice Pattern — generated by pn-docgen
# Service: {{ service_name }}
direction: right

vars: {
  d2-config: {layout-engine: elk}
  elk: {
    "direction": "RIGHT"
    "edgeRouting": "ORTHOGONAL"
    "org.eclipse.elk.hierarchyHandling": "INCLUDE_CHILDREN"
    "org.eclipse.elk.layered.spacing.nodeNodeBetweenLayers": "120"
    "org.eclipse.elk.spacing.nodeNode": "20"
  }
}

classes: {
  aws_node: {
    shape: image
    width: 60
    height: 60
    label.near: outside-bottom-center
    style.font-size: 10
  }
  ecs_hero: {
    shape: image
    width: 110
    height: 110
    label.near: outside-bottom-center
    style.font-size: 13
  }
  boundary: {
    style.fill: transparent
    style.stroke-width: 1
    style.stroke-dash: 3
    style.border-radius: 12
    width: 280
  }
}

{% set has_col1 = clusters.get("apigw") or clusters.get("rules") %}
{% set has_col2 = clusters.get("queues") %}
{% set has_col3 = clusters.get("ecs") or clusters.get("lambdas") %}
{% set has_col4 = clusters.get("dynamodb") or clusters.get("storage") or clusters.get("output_queues") %}
{% set has_col5 = clusters.get("external") %}

{% if has_col1 %}
# ── Column 1: Ingress (API Gateway + EventBridge Rules) ──────────────────────
col1: "" {
  style.fill: transparent
  style.stroke-width: 0
  direction: down

{% if clusters.get("apigw") %}
  apigw: "API Gateway" {
    class: boundary
    style.fill: "#E3F2FD"
    grid-columns: 1
{% for node in clusters["apigw"] %}
    {{ node.id }}: "{{ node.label }}" {
      class: aws_node
{% if node.icon %}
      icon: {{ node.icon }}
{% endif %}
    }
{% endfor %}
  }
{% endif %}

{% if clusters.get("rules") %}
  rules: "EventBridge Rules" {
    class: boundary
    style.fill: "#FFF3E0"
    grid-columns: 1
{% for node in clusters["rules"] %}
    {{ node.id }}: "{{ node.label }}" {
      class: aws_node
{% if node.icon %}
      icon: {{ node.icon }}
{% endif %}
    }
{% endfor %}
  }
{% endif %}
}
{% endif %}

{% if has_col2 %}
# ── Column 2: Queues (SQS + SNS + Kinesis) ───────────────────────────────────
col2: "" {
  style.fill: transparent
  style.stroke-width: 0
  direction: down

  queues: "SQS Queues" {
    class: boundary
    style.fill: "#E3F2FD"
    grid-columns: 1
{% for node in clusters["queues"] %}
    {{ node.id }}: "{{ node.label }}" {
      class: aws_node
{% if node.icon %}
      icon: {{ node.icon }}
{% endif %}
    }
{% endfor %}
  }
}
{% endif %}

{% if has_col3 %}
# ── Column 3: Compute (ECS + Lambda) ─────────────────────────────────────────
col3: "" {
  style.fill: transparent
  style.stroke-width: 0
  direction: down

{% if clusters.get("ecs") %}
  ecs: "ECS Microservice" {
    class: boundary
    style.fill: "#E8F5E9"
    grid-columns: 1
{% for node in clusters["ecs"] %}
    {{ node.id }}: "{{ node.label }}" {
      class: ecs_hero
{% if node.icon %}
      icon: {{ node.icon }}
{% endif %}
    }
{% endfor %}
  }
{% endif %}

{% if clusters.get("lambdas") %}
  lambdas: "Lambda Functions" {
    class: boundary
    style.fill: "#F3E5F5"
    grid-columns: 1
{% for node in clusters["lambdas"] %}
    {{ node.id }}: "{{ node.label }}" {
      class: aws_node
{% if node.icon %}
      icon: {{ node.icon }}
{% endif %}
    }
{% endfor %}
  }
{% endif %}
}
{% endif %}

{% if has_col4 %}
# ── Column 4: Storage (DynamoDB + S3 + Producer Queues) ──────────────────────
col4: "" {
  style.fill: transparent
  style.stroke-width: 0
  direction: down

{% if clusters.get("dynamodb") %}
  dynamodb: "DynamoDB Tables" {
    class: boundary
    style.fill: "#FCE4EC"
    grid-columns: 1
{% for node in clusters["dynamodb"] %}
    {{ node.id }}: "{{ node.label }}" {
      class: aws_node
{% if node.icon %}
      icon: {{ node.icon }}
{% endif %}
    }
{% endfor %}
  }
{% endif %}

{% if clusters.get("storage") %}
  storage: "Storage" {
    class: boundary
    style.fill: "#FCE4EC"
    grid-columns: 1
{% for node in clusters["storage"] %}
    {{ node.id }}: "{{ node.label }}" {
      class: aws_node
{% if node.icon %}
      icon: {{ node.icon }}
{% endif %}
    }
{% endfor %}
  }
{% endif %}

{% if clusters.get("output_queues") %}
  output_queues: "Output Queues" {
    class: boundary
    style.fill: "#E3F2FD"
    grid-columns: 1
{% for node in clusters["output_queues"] %}
    {{ node.id }}: "{{ node.label }}" {
      class: aws_node
{% if node.icon %}
      icon: {{ node.icon }}
{% endif %}
    }
{% endfor %}
  }
{% endif %}
}
{% endif %}

{% if has_col5 %}
# ── Column 5: External Services ───────────────────────────────────────────────
col5: "" {
  style.fill: transparent
  style.stroke-width: 0
  direction: down

  external: "External Services" {
    class: boundary
    style.fill: "#FAFAFA"
    style.stroke-dash: 5
    grid-columns: 1
{% for node in clusters["external"] %}
    {{ node.id }}: "{{ node.label }}" {
      shape: rectangle
      style.border-radius: 4
      style.fill: white
    }
{% endfor %}
  }
}
{% endif %}

# ── Structural edges: enforce column ordering left → right ────────────────────
{% if has_col1 and has_col2 %}
col1 -> col2: "" { style.opacity: 0 }
{% elif has_col1 and has_col3 %}
col1 -> col3: "" { style.opacity: 0 }
{% endif %}
{% if has_col2 and has_col3 %}
col2 -> col3: "" { style.opacity: 0 }
{% endif %}
{% if has_col3 and has_col4 %}
col3 -> col4: "" { style.opacity: 0 }
{% endif %}
{% if has_col4 and has_col5 %}
col4 -> col5: "" { style.opacity: 0 }
{% elif has_col3 and has_col5 %}
col3 -> col5: "" { style.opacity: 0 }
{% endif %}

{% if box_edges %}
# ── Data-flow edges (box-level) ───────────────────────────────────────────────
{% for e in box_edges %}
{{ e.from_box }} -> {{ e.to_box }}{% if e.label %}: "{{ e.label }}"{% endif %} {
  style.stroke: "{{ e.stroke_color }}"
  style.stroke-width: 2
  style.font-size: 14
{% if e.stroke_dash %}
  style.stroke-dash: 5
{% endif %}
{% if e.animated %}
  style.animated: true
{% endif %}
}
{% endfor %}
{% endif %}
