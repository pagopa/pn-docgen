{# pn-docgen L3 ECS Microservice Template (v74 Golden Layout)
   Pattern: ecs_microservice

   Layout — ricetta v6 (esperimento 002):
     - cluster emessi al primo livello, senza wrapper di colonna
     - grid-columns calcolato dal numero di figli
     - boundary senza larghezza fissa, così la griglia può crescere
     - Box-level edges between clusters (not node-level) → ELK orthogonal routing works
     - Ordine di lettura: ingresso → code → calcolo → storage, deciso da ELK

   Input variables:
     service_name  : str  — e.g. "pn-delivery"
     service_id    : str  — safe D2 id (unused in body, for comment only)
     clusters      : dict — {cluster_name: [{id, label, icon, width, height, resource_type}]}
                     Expected keys: apigw, rules, queues, ecs, lambdas, dynamodb, storage, external
     box_edges     : list — [{from_box, to_box, label, stroke_color, stroke_dash}]
                     Box-level (cluster→cluster) edges, pre-computed by generator
     structural_edges: list — (unused, column structure embedded in template)
#}

# StandardAWSLayout v6 — ECS Microservice Pattern — generated by pn-docgen
# Service: {{ service_name }}
direction: right

vars: {
  d2-config: {layout-engine: elk}
}

classes: {
  aws_node: {
    shape: image
    width: 60
    height: 60
    label.near: outside-bottom-center
    style.font-size: 10
  }
  ecs_hero: {
    shape: image
    width: 110
    height: 110
    label.near: outside-bottom-center
    style.font-size: 13
  }
  boundary: {
    style.fill: transparent
    style.stroke-width: 1
    style.stroke-dash: 3
    style.border-radius: 12
  }
}

{% if clusters.get("apigw") %}
# ── Ingress: API Gateway ─────────────────────────────────────────────────────
apigw: "API Gateway" {
  class: boundary
  style.fill: "{{ cluster_fills.get('apigw', cluster_fills['default']) }}"
  grid-columns: {{ grid_columns.get("apigw", 1) }}
{% for node in clusters["apigw"] %}
  {{ node.id }}: "{{ node.label }}" {
    class: aws_node
{% if node.icon %}
    icon: {{ node.icon }}
{% else %}
    shape: rectangle
{% endif %}
  }
{% endfor %}
}
{% endif %}

{% if clusters.get("rules") %}
# ── Ingress: EventBridge Rules ───────────────────────────────────────────────
rules: "{{ rules_title }}" {
  class: boundary
  style.fill: "{{ cluster_fills.get('rules', cluster_fills['default']) }}"
  grid-columns: {{ grid_columns.get("rules", 1) }}
{% for node in clusters["rules"] %}
  {{ node.id }}: "{{ node.label }}" {
    class: aws_node
{% if node.icon %}
    icon: {{ node.icon }}
{% else %}
    shape: rectangle
{% endif %}
  }
{% endfor %}
}
{% endif %}

{% if clusters.get("queues") %}
# ── Queues (SQS + SNS + Kinesis) ─────────────────────────────────────────────
queues: "{{ queues_title }}" {
  class: boundary
  style.fill: "{{ cluster_fills.get('queues', cluster_fills['default']) }}"
  grid-columns: {{ grid_columns.get("queues", 1) }}
{% for node in clusters["queues"] %}
  {{ node.id }}: "{{ node.label }}" {
    class: aws_node
{% if node.icon %}
    icon: {{ node.icon }}
{% else %}
    shape: rectangle
{% endif %}
  }
{% endfor %}
}
{% endif %}

{% if clusters.get("ecs") %}
# ── Compute: ECS ─────────────────────────────────────────────────────────────
ecs: "ECS Microservice" {
  class: boundary
  style.fill: "{{ cluster_fills.get('ecs', cluster_fills['default']) }}"
  grid-columns: {{ grid_columns.get("ecs", 1) }}
{% for node in clusters["ecs"] %}
  {{ node.id }}: "{{ node.label }}" {
    class: ecs_hero
{% if node.icon %}
    icon: {{ node.icon }}
{% else %}
    shape: rectangle
{% endif %}
  }
{% endfor %}
}
{% endif %}

{% if clusters.get("lambdas") %}
# ── Compute: Lambda ──────────────────────────────────────────────────────────
lambdas: "Lambda Functions" {
  class: boundary
  style.fill: "{{ cluster_fills.get('lambdas', cluster_fills['default']) }}"
  grid-columns: {{ grid_columns.get("lambdas", 1) }}
{% for node in clusters["lambdas"] %}
  {{ node.id }}: "{{ node.label }}" {
    class: aws_node
{% if node.icon %}
    icon: {{ node.icon }}
{% else %}
    shape: rectangle
{% endif %}
  }
{% endfor %}
}
{% endif %}

{% if clusters.get("dynamodb") %}
# ── Storage: DynamoDB ────────────────────────────────────────────────────────
dynamodb: "DynamoDB Tables" {
  class: boundary
  style.fill: "{{ cluster_fills.get('dynamodb', cluster_fills['default']) }}"
  grid-columns: {{ grid_columns.get("dynamodb", 1) }}
{% for node in clusters["dynamodb"] %}
  {{ node.id }}: "{{ node.label }}" {
    class: aws_node
{% if node.icon %}
    icon: {{ node.icon }}
{% else %}
    shape: rectangle
{% endif %}
  }
{% endfor %}
}
{% endif %}

{% if clusters.get("storage") %}
# ── Storage: bucket e altri store ────────────────────────────────────────────
storage: "Storage" {
  class: boundary
  style.fill: "{{ cluster_fills.get('storage', cluster_fills['default']) }}"
  grid-columns: {{ grid_columns.get("storage", 1) }}
{% for node in clusters["storage"] %}
  {{ node.id }}: "{{ node.label }}" {
    class: aws_node
{% if node.icon %}
    icon: {{ node.icon }}
{% else %}
    shape: rectangle
{% endif %}
  }
{% endfor %}
}
{% endif %}

{% if clusters.get("output_queues") %}
# ── Output Queues ────────────────────────────────────────────────────────────
output_queues: "Output Queues" {
  class: boundary
  style.fill: "{{ cluster_fills.get('output_queues', cluster_fills['default']) }}"
  grid-columns: {{ grid_columns.get("output_queues", 1) }}
{% for node in clusters["output_queues"] %}
  {{ node.id }}: "{{ node.label }}" {
    class: aws_node
{% if node.icon %}
    icon: {{ node.icon }}
{% else %}
    shape: rectangle
{% endif %}
  }
{% endfor %}
}
{% endif %}

{% if clusters.get("external") %}
# ── External Services ────────────────────────────────────────────────────────
external: "External Services" {
  class: boundary
  style.fill: "{{ cluster_fills.get('external', cluster_fills['default']) }}"
  style.stroke-dash: 5
  grid-columns: {{ grid_columns.get("external", 1) }}
{% for node in clusters["external"] %}
  {{ node.id }}: "{{ node.label }}" {
    shape: rectangle
    style.border-radius: 4
    style.fill: white
  }
{% endfor %}
}
{% endif %}

{% if box_edges %}
# ── Data-flow edges (box-level) ───────────────────────────────────────────────
{% for e in box_edges %}
{{ e.from_box }} -> {{ e.to_box }}{% if e.label %}: "{{ e.label }}"{% endif %} {
  style.stroke: "{{ e.stroke_color }}"
  style.stroke-width: 2
  style.font-size: 14
{% if e.stroke_dash %}
  style.stroke-dash: 5
{% endif %}
{% if e.animated %}
  style.animated: true
{% endif %}
}
{% endfor %}
{% endif %}
