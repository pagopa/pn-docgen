{# pn-docgen L2 Service Map Template #}
{# Input variables:
   title        : str  - diagram title, e.g. "SEND Service Map"
   components   : list - [{id, name, resource_count, dominant_type, icon}]
   edges        : list - [{from_id, to_id, label, edge_type, animated}] cross-component arrows
#}

# StandardAWSLayout — L2 Service Map — generated by pn-docgen
direction: right

vars: {
  d2-config: {
    layout-engine: elk
  }
  elk: {
    "direction": "RIGHT"
    "edgeRouting": "ORTHOGONAL"
    "portAlignment.default": "CENTER"
    "org.eclipse.elk.hierarchyHandling": "INCLUDE_CHILDREN"
    "org.eclipse.elk.layered.edgeRouting": "ORTHOGONAL"
    "org.eclipse.elk.layered.spacing.nodeNodeBetweenLayers": "200"
    "org.eclipse.elk.spacing.nodeNode": "120"
  }
}

classes: {
  service_box: {
    shape: rectangle
    style.border-radius: 8
    style.fill: "#FAFAFA"
    style.stroke: "#90A4AE"
    style.stroke-width: 1
    style.font-size: 13
    style.font-color: "#263238"
  }
  service_icon: {
    shape: image
    width: 48
    height: 48
    label.near: outside-bottom-center
    style.font-size: 11
  }
}

# ── Service Map: {{ title }} ────────────────────────────────────────────────

{% for comp in components %}
{{ comp.id }}: "{{ comp.name }}" {
  class: service_box
  label: "{{ comp.name }}\n({{ comp.resource_count }} resources)"
{% if comp.icon %}
  icon: {{ comp.icon }}
{% endif %}
  style.fill: "{{ service_fill }}"
}
{% endfor %}

{% if edges %}
# Cross-component data-flow edges
{% for e in edges %}
{{ e.from_id }} -> {{ e.to_id }}: "{{ e.label }}" {
{% if e.animated %}
  style.animated: true
{% endif %}
  style.stroke: "#4A90D9"
  style.stroke-width: 2
  style.font-size: 11
}
{% endfor %}
{% endif %}
