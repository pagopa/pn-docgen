{# pn-docgen L3 ECS Microservice Template — DETAILED view (v65 style)
   Pattern: ecs_microservice, detail_level: detailed

   Layout — node-level edges, pure ELK without grid-columns:
     - 5 invisible column wrappers (col1…col5) with direction:down
     - NO grid-columns inside boxes (ELK handles inner layout)
     - Node-level edges with full D2 paths (col2.queues.node → col3.ecs.node)
     - ELK ORTHOGONAL routing

   Input variables:
     service_name  : str
     service_id    : str
     clusters      : dict — {cluster_name: [{id, label, icon, width, height, resource_type}]}
     data_edges    : list — [{from_path, to_path, label, stroke_color, stroke_dash, animated}]
     invisible_data_edges: list — [{from_path, to_path}]
#}

# StandardAWSLayout v65 Detailed — ECS Microservice Pattern — generated by pn-docgen
# Service: {{ service_name }}
direction: right

vars: {
  d2-config: {layout-engine: elk}
  elk: {
    "direction": "RIGHT"
    "edgeRouting": "ORTHOGONAL"
    "org.eclipse.elk.hierarchyHandling": "INCLUDE_CHILDREN"
    "org.eclipse.elk.layered.spacing.nodeNodeBetweenLayers": "120"
    "org.eclipse.elk.spacing.nodeNode": "40"
  }
}

classes: {
  aws_node: {
    shape: image
    width: 60
    height: 60
    label.near: outside-bottom-center
    style.font-size: 10
  }
  ecs_hero: {
    shape: image
    width: 110
    height: 110
    label.near: outside-bottom-center
    style.font-size: 13
  }
  boundary: {
    style.fill: transparent
    style.stroke-width: 1
    style.stroke-dash: 3
    style.border-radius: 12
    width: 280
  }
}

{% set has_col1 = clusters.get("apigw") or clusters.get("rules") %}
{% set has_col2 = clusters.get("queues") %}
{% set has_col3 = clusters.get("ecs") or clusters.get("lambdas") %}
{% set has_col4 = clusters.get("dynamodb") or clusters.get("storage") %}
{% set has_col5 = clusters.get("external") %}

{% if has_col1 %}
col1: "" {
  style.fill: transparent
  style.stroke-width: 0
  direction: down

{% if clusters.get("apigw") %}
  apigw: "API Gateway" {
    class: boundary
    style.fill: "#E3F2FD"
    width: 280
    direction: down
{% for node in clusters["apigw"] %}
    {{ node.id }}: "{{ node.label }}" {
      class: aws_node
{% if node.icon %}
      icon: {{ node.icon }}
{% endif %}
    }
{% endfor %}
  }
{% endif %}

{% if clusters.get("rules") %}
  rules: "EventBridge Rules" {
    class: boundary
    style.fill: "#FFF3E0"
    width: 280
    direction: down
{% for node in clusters["rules"] %}
    {{ node.id }}: "{{ node.label }}" {
      class: aws_node
{% if node.icon %}
      icon: {{ node.icon }}
{% endif %}
    }
{% endfor %}
  }
{% endif %}
}
{% endif %}

{% if has_col2 %}
col2: "" {
  style.fill: transparent
  style.stroke-width: 0
  direction: down

  queues: "SQS Queues" {
    class: boundary
    style.fill: "#E3F2FD"
    width: 280
    direction: down
{% for node in clusters["queues"] %}
    {{ node.id }}: "{{ node.label }}" {
      class: aws_node
{% if node.icon %}
      icon: {{ node.icon }}
{% endif %}
    }
{% endfor %}
  }
}
{% endif %}

{% if has_col3 %}
col3: "" {
  style.fill: transparent
  style.stroke-width: 0
  direction: down

{% if clusters.get("ecs") %}
  ecs: "ECS Microservice" {
    class: boundary
    style.fill: "#E8F5E9"
    width: 280
    direction: down
{% for node in clusters["ecs"] %}
    {{ node.id }}: "{{ node.label }}" {
      class: ecs_hero
{% if node.icon %}
      icon: {{ node.icon }}
{% endif %}
    }
{% endfor %}
  }
{% endif %}

{% if clusters.get("lambdas") %}
  lambdas: "Lambda Functions" {
    class: boundary
    style.fill: "#F3E5F5"
    width: 280
    direction: down
{% for node in clusters["lambdas"] %}
    {{ node.id }}: "{{ node.label }}" {
      class: aws_node
{% if node.icon %}
      icon: {{ node.icon }}
{% endif %}
    }
{% endfor %}
  }
{% endif %}
}
{% endif %}

{% if has_col4 %}
col4: "" {
  style.fill: transparent
  style.stroke-width: 0
  direction: down

{% if clusters.get("dynamodb") %}
  dynamodb: "DynamoDB Tables" {
    class: boundary
    style.fill: "#FCE4EC"
    width: 280
    direction: down
{% for node in clusters["dynamodb"] %}
    {{ node.id }}: "{{ node.label }}" {
      class: aws_node
{% if node.icon %}
      icon: {{ node.icon }}
{% endif %}
    }
{% endfor %}
  }
{% endif %}

{% if clusters.get("storage") %}
  storage: "Storage" {
    class: boundary
    style.fill: "#FCE4EC"
    width: 280
    direction: down
{% for node in clusters["storage"] %}
    {{ node.id }}: "{{ node.label }}" {
      class: aws_node
{% if node.icon %}
      icon: {{ node.icon }}
{% endif %}
    }
{% endfor %}
  }
{% endif %}
}
{% endif %}

{% if has_col5 %}
col5: "" {
  style.fill: transparent
  style.stroke-width: 0
  direction: down

  external: "External Services" {
    class: boundary
    style.fill: "#FAFAFA"
    style.stroke-dash: 5
    width: 280
    direction: down
{% for node in clusters["external"] %}
    {{ node.id }}: "{{ node.label }}" {
      shape: rectangle
      style.border-radius: 4
      style.fill: white
    }
{% endfor %}
  }
}
{% endif %}

# ── Structural edges: enforce column ordering ─────────────────────────────────
{% if has_col1 and has_col2 %}
col1 -> col2: "" { style.opacity: 0 }
{% elif has_col1 and has_col3 %}
col1 -> col3: "" { style.opacity: 0 }
{% endif %}
{% if has_col2 and has_col3 %}
col2 -> col3: "" { style.opacity: 0 }
{% endif %}
{% if has_col3 and has_col4 %}
col3 -> col4: "" { style.opacity: 0 }
{% endif %}
{% if has_col4 and has_col5 %}
col4 -> col5: "" { style.opacity: 0 }
{% elif has_col3 and has_col5 %}
col3 -> col5: "" { style.opacity: 0 }
{% endif %}

{% if data_edges %}
# ── Data-flow edges (node-level) ──────────────────────────────────────────────
{% for e in data_edges %}
{{ e.from_path }} -> {{ e.to_path }}{% if e.label %}: "{{ e.label }}"{% endif %} {
  label.near: outside-left-center
  style.stroke: "{{ e.stroke_color | default('#1565C0') }}"
  style.stroke-width: 2
  style.font-size: 10
{% if e.stroke_dash %}
  style.stroke-dash: 5
{% endif %}
{% if e.animated %}
  style.animated: true
{% endif %}
}
{% endfor %}
{% endif %}

{% if invisible_data_edges %}
# ── Invisible mirror edges (orphan queue alignment) ───────────────────────────
{% for e in invisible_data_edges %}
{{ e.from_path }} -> {{ e.to_path }}: "" { style.opacity: 0 }
{% endfor %}
{% endif %}
