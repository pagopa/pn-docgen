{# pn-docgen L3 ECS Microservice Template — DETAILED view (v65 style)
   Pattern: ecs_microservice, detail_level: detailed

   Layout — node-level edges, pure ELK without grid-columns:
     - cluster emessi al primo livello, senza wrapper di colonna
     - NO grid-columns inside boxes (ELK handles inner layout)
     - Node-level edges with full D2 paths (queues.node → ecs.node)
     - ELK ORTHOGONAL routing

   Input variables:
     service_name  : str
     service_id    : str
     clusters      : dict — {cluster_name: [{id, label, icon, width, height, resource_type}]}
     data_edges    : list — [{from_path, to_path, label, stroke_color, stroke_dash, animated}]
     invisible_data_edges: list — [{from_path, to_path}]
#}

# StandardAWSLayout v6 Detailed — ECS Microservice Pattern — generated by pn-docgen
# Service: {{ service_name }}
direction: right

vars: {
  d2-config: {layout-engine: elk}
}

classes: {
  aws_node: {
    shape: image
    width: 60
    height: 60
    label.near: outside-bottom-center
    style.font-size: 10
  }
  ecs_hero: {
    shape: image
    width: 110
    height: 110
    label.near: outside-bottom-center
    style.font-size: 13
  }
  boundary: {
    style.fill: transparent
    style.stroke-width: 1
    style.stroke-dash: 3
    style.border-radius: 12
  }
}

{% if clusters.get("apigw") %}
apigw: "API Gateway" {
  class: boundary
  style.fill: "{{ cluster_fills.get('apigw', cluster_fills['default']) }}"
  width: 280
  direction: down
{% for node in clusters["apigw"] %}
  {{ node.id }}: "{{ node.label }}" {
    class: aws_node
{% if node.icon %}
    icon: {{ node.icon }}
{% else %}
    shape: rectangle
{% endif %}
  }
{% endfor %}
}
{% endif %}

{% if clusters.get("rules") %}
rules: "{{ rules_title }}" {
  class: boundary
  style.fill: "{{ cluster_fills.get('rules', cluster_fills['default']) }}"
  width: 280
  direction: down
{% for node in clusters["rules"] %}
  {{ node.id }}: "{{ node.label }}" {
    class: aws_node
{% if node.icon %}
    icon: {{ node.icon }}
{% else %}
    shape: rectangle
{% endif %}
  }
{% endfor %}
}
{% endif %}

{% if clusters.get("queues") %}
queues: "{{ queues_title }}" {
  class: boundary
  style.fill: "{{ cluster_fills.get('queues', cluster_fills['default']) }}"
  width: 280
  direction: down
{% for node in clusters["queues"] %}
  {{ node.id }}: "{{ node.label }}" {
    class: aws_node
{% if node.icon %}
    icon: {{ node.icon }}
{% else %}
    shape: rectangle
{% endif %}
  }
{% endfor %}
}
{% endif %}

{% if clusters.get("ecs") %}
ecs: "ECS Microservice" {
  class: boundary
  style.fill: "{{ cluster_fills.get('ecs', cluster_fills['default']) }}"
  width: 280
  direction: down
{% for node in clusters["ecs"] %}
  {{ node.id }}: "{{ node.label }}" {
    class: ecs_hero
{% if node.icon %}
    icon: {{ node.icon }}
{% else %}
    shape: rectangle
{% endif %}
  }
{% endfor %}
}
{% endif %}

{% if clusters.get("lambdas") %}
lambdas: "Lambda Functions" {
  class: boundary
  style.fill: "{{ cluster_fills.get('lambdas', cluster_fills['default']) }}"
  width: 280
  direction: down
{% for node in clusters["lambdas"] %}
  {{ node.id }}: "{{ node.label }}" {
    class: aws_node
{% if node.icon %}
    icon: {{ node.icon }}
{% else %}
    shape: rectangle
{% endif %}
  }
{% endfor %}
}
{% endif %}

{% if clusters.get("dynamodb") %}
dynamodb: "DynamoDB Tables" {
  class: boundary
  style.fill: "{{ cluster_fills.get('dynamodb', cluster_fills['default']) }}"
  width: 280
  direction: down
{% for node in clusters["dynamodb"] %}
  {{ node.id }}: "{{ node.label }}" {
    class: aws_node
{% if node.icon %}
    icon: {{ node.icon }}
{% else %}
    shape: rectangle
{% endif %}
  }
{% endfor %}
}
{% endif %}

{% if clusters.get("storage") %}
storage: "Storage" {
  class: boundary
  style.fill: "{{ cluster_fills.get('storage', cluster_fills['default']) }}"
  width: 280
  direction: down
{% for node in clusters["storage"] %}
  {{ node.id }}: "{{ node.label }}" {
    class: aws_node
{% if node.icon %}
    icon: {{ node.icon }}
{% else %}
    shape: rectangle
{% endif %}
  }
{% endfor %}
}
{% endif %}

{% if clusters.get("output_queues") %}
output_queues: "Output Queues" {
  class: boundary
  style.fill: "{{ cluster_fills.get('output_queues', cluster_fills['default']) }}"
  width: 280
  direction: down
{% for node in clusters["output_queues"] %}
  {{ node.id }}: "{{ node.label }}" {
    class: aws_node
{% if node.icon %}
    icon: {{ node.icon }}
{% else %}
    shape: rectangle
{% endif %}
  }
{% endfor %}
}
{% endif %}

{% if clusters.get("external") %}
external: "External Services" {
  class: boundary
  style.fill: "{{ cluster_fills.get('external', cluster_fills['default']) }}"
  style.stroke-dash: 5
  width: 280
  direction: down
{% for node in clusters["external"] %}
  {{ node.id }}: "{{ node.label }}" {
    shape: rectangle
    style.border-radius: 4
    style.fill: white
  }
{% endfor %}
}
{% endif %}

{% if data_edges %}
# ── Data-flow edges (node-level) ──────────────────────────────────────────────
{% for e in data_edges %}
{{ e.from_path }} -> {{ e.to_path }}{% if e.label %}: "{{ e.label }}"{% endif %} {
  label.near: outside-left-center
  style.stroke: "{{ e.stroke_color | default('#1565C0') }}"
  style.stroke-width: 2
  style.font-size: 10
{% if e.stroke_dash %}
  style.stroke-dash: 5
{% endif %}
{% if e.animated %}
  style.animated: true
{% endif %}
}
{% endfor %}
{% endif %}

{% if invisible_data_edges %}
# ── Invisible mirror edges (orphan queue alignment) ───────────────────────────
{% for e in invisible_data_edges %}
{{ e.from_path }} -> {{ e.to_path }}: "" { style.opacity: 0 }
{% endfor %}
{% endif %}
