{# pn-docgen L3 Microservice Diagram Template
   Flat clusters, ECS hero in compute, invisible ordering edges.

   Input variables:
   service_name     : str  - e.g. "pn-delivery"
   service_id       : str  - safe D2 id prefix, e.g. "pn_delivery"
   clusters         : dict - {cluster_name: [{id, label, icon, width, height}]}
   alignment_edges  : list - [(from_cluster, to_cluster)] invisible ordering
   data_edges       : list - [{from_path, to_path, label, animated}]
#}

# StandardAWSLayout — generated by pn-docgen
# Service: {{ service_name }}
direction: right

vars: {
  d2-config: {
    layout-engine: elk
  }
  elk: {
    "direction": "RIGHT"
    "edgeRouting": "ORTHOGONAL"
    "portAlignment.default": "CENTER"
    "org.eclipse.elk.hierarchyHandling": "INCLUDE_CHILDREN"
    "org.eclipse.elk.layered.edgeRouting": "ORTHOGONAL"
    "org.eclipse.elk.layered.spacing.nodeNodeBetweenLayers": "180"
    "org.eclipse.elk.spacing.nodeNode": "100"
  }
}

classes: {
  aws_node: {
    shape: image
    width: 60
    height: 60
    label.near: outside-bottom-center
    style.font-size: 10
  }
  boundary: {
    style.fill: transparent
    style.stroke-width: 1
    style.stroke-dash: 3
    style.border-radius: 12
  }
}

# ── Clusters ────────────────────────────────────────────────────────────────

{% for cluster_name, nodes in clusters.items() %}
{% if nodes %}
{{ cluster_name }}: "{{ cluster_name | title }}" {
  class: boundary
{% if cluster_name == "inputs" %}
  style.fill: "#E3F2FD"
{% elif cluster_name == "compute" %}
  style.fill: "#E8F5E9"
{% elif cluster_name == "messaging" %}
  style.fill: "#FFF3E0"
{% elif cluster_name == "storage" %}
  style.fill: "#FCE4EC"
{% elif cluster_name == "security" %}
  style.fill: "#F3E5F5"
{% else %}
  style.fill: "#F5F5F5"
{% endif %}
{% for node in nodes %}
  {{ node.id }}: "{{ node.label }}" {
    class: aws_node
{% if node.icon %}
    icon: {{ node.icon }}
{% endif %}
    width: {{ node.width }}
    height: {{ node.height }}
  }
{% endfor %}
}

{% endif %}
{% endfor %}

{% if structural_edges %}
# Invisible structural edges (pattern-based topology hints for ELK)
# Keep compute between inputs and storage.
{% for e in structural_edges %}
{{ e.from_path }} -> {{ e.to_path }}: "" {
  style.opacity: 0
}
{% endfor %}
{% endif %}

{% if data_edges %}
# Data-flow edges (real arrows from discovered relationships)
{% for e in data_edges %}
{{ e.from_path }} -> {{ e.to_path }}: "{{ e.label }}" {
{% if e.animated %}
  style.animated: true
{% endif %}
  style.stroke: "#4A90D9"
  style.stroke-width: 2
  style.font-size: 10
}
{% endfor %}
{% endif %}
