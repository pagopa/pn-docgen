{# pn-docgen L3 Microservice Diagram Template
   Flat clusters, ECS hero in compute, invisible ordering edges.

   Input variables:
   service_name     : str  - e.g. "pn-delivery"
   service_id       : str  - safe D2 id prefix, e.g. "pn_delivery"
   clusters         : dict - {cluster_name: [{id, label, icon, width, height}]}
   alignment_edges  : list - [(from_cluster, to_cluster)] invisible ordering
   data_edges       : list - [{from_path, to_path, label, animated}]
#}

# StandardAWSLayout — generated by pn-docgen
# Service: {{ service_name }}
direction: right

vars: {
  d2-config: {
    layout-engine: elk
  }
}

classes: {
  aws_node: {
    shape: image
    width: 60
    height: 60
    label.near: outside-bottom-center
    style.font-size: 10
  }
  boundary: {
    style.fill: transparent
    style.stroke-width: 1
    style.stroke-dash: 3
    style.border-radius: 12
  }
}

# ── Clusters ────────────────────────────────────────────────────────────────

{% for cluster_name, nodes in clusters.items() %}
{% if nodes %}
{{ cluster_name }}: "{{ cluster_name | title }}" {
  class: boundary
  direction: down
{% if cluster_name in generic_grids %}
  grid-columns: {{ generic_grids[cluster_name] }}
{% endif %}
  style.fill: "{{ cluster_fills.get(cluster_name, cluster_fills['default']) }}"
{% for node in nodes %}
  {{ node.id }}: "{{ node.label }}" {
    class: aws_node
{% if node.icon %}
    icon: {{ node.icon }}
{% else %}
    shape: rectangle
{% endif %}
    width: {{ node.width }}
    height: {{ node.height }}
  }
{% endfor %}
}

{% endif %}
{% endfor %}

{% if structural_edges %}
# Invisible structural edges (pattern-based topology hints for ELK)
# Keep compute between inputs and storage.
{% for e in structural_edges %}
{{ e.from_path }} -> {{ e.to_path }}: "" {
  style.opacity: 0
}
{% endfor %}
{% endif %}

{% if data_edges %}
# Data-flow edges (real arrows from discovered relationships)
{% for e in data_edges %}
{{ e.from_path }} -> {{ e.to_path }}: "{{ e.label }}" {
{% if e.animated %}
  style.animated: true
{% endif %}
  style.stroke: "#4A90D9"
  style.stroke-width: 2
  style.font-size: 10
}
{% endfor %}
{% endif %}

{% if box_edges %}
# Simplified: one directed edge per cluster pair, actual labels preserved.
{% for e in box_edges %}
{{ e.from_box }} -> {{ e.to_box }}: "{{ e.label }}" {
  style.stroke: "{{ e.stroke_color }}"
  style.stroke-width: 2
  style.font-size: 10
{% if e.stroke_dash %}
  style.stroke-dash: 3
{% endif %}
}
{% endfor %}
{% endif %}
